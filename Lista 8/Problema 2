#include <stdio.h>
#include <stdlib.h>
#include <inttypes.h>

typedef union {
    uint32_t valor_total;

    struct {
        uint32_t id            : 10; 
        uint32_t status        : 3;  
        uint32_t bateria_baixa : 1;  
        int temperatura        : 12; 
        uint32_t paridade      : 6;  
    } campos;
    
} Pacote;

int main() {
    Pacote* lista_num = malloc(sizeof(Pacote));
    if (lista_num == NULL) {
        free(lista_num);
        exit(1);
    }

    int i = 0, lenght = 1;
    while (1) {
        Pacote temp_val;

        if (scanf("%i", &temp_val.valor_total) != 1 || temp_val.valor_total == 0) break;

        if (i + 1 == lenght) {
            Pacote* temp_ptr = realloc(lista_num, (2 * i + 2) * sizeof(Pacote));
            if (temp_ptr == NULL) {
                free(lista_num);
                return 1;
            }
            lista_num = temp_ptr;
            lenght = 2 * i + 2;
        }

        lista_num[i] = temp_val;
        i++;
    }

    for (int j = 0; j < i; j++) {
        printf("Pacote [%d] - Dado Bruto: 0x%08X\n", j + 1, lista_num[j].valor_total);
        printf("ID do Sensor    : %u\n", lista_num[j].campos.id);
        printf("Status     : %u\n", lista_num[j].campos.status);
        printf("Bateria Baixa   : %s\n", lista_num[j].campos.bateria_baixa ? "SIM (ALERTA)" : "Nao");
        printf("Temperatura     : %d graus\n", lista_num[j].campos.temperatura);
        printf("-------------------------------------------------------\n");
    }

    free(lista_num);
    return 0;
}
